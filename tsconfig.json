{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@miuui/core": ["./packages/core/src/index.ts"],
      "@miuui/tokens": ["./packages/tokens/src/index.ts"],
      "@miuui/icons/dynamic": ["./packages/icons/src/dynamic.ts"],
      "@miuui/icons/brand": ["./packages/icons/src/brand.ts"],
      "@miuui/icons": ["./packages/icons/src/index.ts"],
      "@miuui/materials": ["./packages/materials/src/index.ts"],
      "@miuui/motions": ["./packages/motions/src/index.ts"],
      "@miuui/vue": ["./packages/vue/src/index.ts"],
      "@miuui/codemod": ["./packages/codemod/src/index.ts"]
    }
  },
  "include": ["env.d.ts", "packages/**/*.ts", "packages/**/*.vue", "vitest.config.ts"],
  "exclude": ["**/node_modules", "**/dist"]
}

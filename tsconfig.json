{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@xcmm1543/miuui-core": ["./packages/core/src/index.ts"],
      "@xcmm1543/miuui-tokens": ["./packages/tokens/src/index.ts"],
      "@xcmm1543/miuui-icons/dynamic": ["./packages/icons/src/dynamic.ts"],
      "@xcmm1543/miuui-icons/brand": ["./packages/icons/src/brand.ts"],
      "@xcmm1543/miuui-icons": ["./packages/icons/src/index.ts"],
      "@xcmm1543/miuui-materials": ["./packages/materials/src/index.ts"],
      "@xcmm1543/miuui-motions": ["./packages/motions/src/index.ts"],
      "@xcmm1543/miuui-vue": ["./packages/vue/src/index.ts"],
      "@xcmm1543/miuui-codemod": ["./packages/codemod/src/index.ts"]
    }
  },
  "include": ["env.d.ts", "packages/**/*.ts", "packages/**/*.vue", "vitest.config.ts"],
  "exclude": ["**/node_modules", "**/dist"]
}

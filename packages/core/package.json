{
  "name": "@xcmm1543/miuui-core",
  "version": "1.0.0",
  "description": "μui framework-agnostic component recipes, plugin contracts and registries",
  "homepage": "https://github.com/Summe-rsnow/miuui#readme",
  "bugs": {
    "url": "https://github.com/Summe-rsnow/miuui/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Summe-rsnow/miuui.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs core",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@xcmm1543/miuui-tokens": "workspace:^"
  }
}

{
  "name": "@miuui/motions",
  "version": "0.5.5",
  "description": "μui pluggable motion tiers: full, reduced and none",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs motions",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@miuui/core": "file:../core"
  }
}

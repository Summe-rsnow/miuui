{
  "name": "@xcmm1543/miuui-codemod",
  "version": "0.6.0",
  "description": "μui AST/template codemods for SemVer deprecation migrations",
  "homepage": "https://github.com/Summe-rsnow/miuui#readme",
  "bugs": {
    "url": "https://github.com/Summe-rsnow/miuui/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Summe-rsnow/miuui.git",
    "directory": "packages/codemod"
  },
  "bin": {
    "miuui-codemod": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs codemod",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}

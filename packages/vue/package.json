{
  "name": "@xcmm1543/miuui-vue",
  "version": "0.8.1",
  "description": "μui Vue 3.5+ adapter built on Reka UI primitives",
  "homepage": "https://github.com/Summe-rsnow/miuui#readme",
  "bugs": {
    "url": "https://github.com/Summe-rsnow/miuui/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Summe-rsnow/miuui.git",
    "directory": "packages/vue"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./components.css": "./dist/components.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs vue",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@xcmm1543/miuui-core": "workspace:^",
    "@xcmm1543/miuui-icons": "workspace:^",
    "@xcmm1543/miuui-tokens": "workspace:^"
  },
  "devDependencies": {
    "reka-ui": "^2.11.0",
    "vue": "^3.5.46"
  },
  "peerDependencies": {
    "reka-ui": ">=2.11.0 <3.0.0",
    "vue": "^3.5.0"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 113",
    "safari >= 15.4"
  ]
}

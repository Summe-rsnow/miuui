{
  "name": "@miuui/materials",
  "version": "0.5.0",
  "description": "μui pluggable surface materials: solid, mica and glass",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs materials",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@miuui/core": "file:../core",
    "@miuui/tokens": "file:../tokens"
  }
}

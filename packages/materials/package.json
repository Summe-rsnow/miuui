{
  "name": "@xcmm1543/miuui-materials",
  "version": "0.7.0",
  "description": "μui pluggable surface materials: solid, mica and glass",
  "homepage": "https://github.com/Summe-rsnow/miuui#readme",
  "bugs": {
    "url": "https://github.com/Summe-rsnow/miuui/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Summe-rsnow/miuui.git",
    "directory": "packages/materials"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs materials",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@xcmm1543/miuui-core": "workspace:^",
    "@xcmm1543/miuui-tokens": "workspace:^"
  }
}

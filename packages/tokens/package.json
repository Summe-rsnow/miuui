{
  "name": "@xcmm1543/miuui-tokens",
  "version": "0.8.0",
  "description": "μui OKLCH palette generator, four-layer design tokens and W3C DTCG exporter",
  "homepage": "https://github.com/Summe-rsnow/miuui#readme",
  "bugs": {
    "url": "https://github.com/Summe-rsnow/miuui/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Summe-rsnow/miuui.git",
    "directory": "packages/tokens"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/tokens.css",
    "./dtcg.json": "./dist/tokens.dtcg.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "tokens:build": "oxnode scripts/build.ts",
    "build": "node ../../scripts/build-packages.mjs tokens",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "ajv": "^8.20.0"
  }
}

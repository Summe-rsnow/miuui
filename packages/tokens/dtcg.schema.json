{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "W3C Design Tokens Community Group export",
  "definitions": {
    "token": {
      "type": "object",
      "required": ["$type", "$value"],
      "properties": {
        "$type": {
          "enum": [
            "color",
            "dimension",
            "duration",
            "cubicBezier",
            "number",
            "fontFamily",
            "fontWeight",
            "shadow"
          ]
        },
        "$value": {},
        "$description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "additionalProperties": {
        "anyOf": [{ "$ref": "#/definitions/token" }, { "$ref": "#/definitions/group" }]
      }
    }
  },
  "$ref": "#/definitions/group"
}
